# ---------------------------------------------------------------- application
APP_NAME="RightsFlow AI"
APP_ENV=development            # development | test | staging | production
LOG_LEVEL=INFO
LOG_JSON=false                 # true in production for structured JSON logs

# ---------------------------------------------------------------- database (MariaDB / MySQL)
DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/rightsflow_ai
# Tests use a separate database; default is the dev name + "_test".
# TEST_DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/rightsflow_ai_test

# ---------------------------------------------------------------- authentication
# REQUIRED. At least 32 random characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_EXPIRE_HOURS=48
INVITATION_EXPIRE_DAYS=7
REQUIRE_EMAIL_VERIFICATION=false
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------- HTTP
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
TRUSTED_PROXY_COUNT=0          # set to the number of reverse proxies in front of the API

# ---------------------------------------------------------------- file storage
STORAGE_BACKEND=local          # local | s3
# STORAGE_LOCAL_PATH=./storage/files
STORAGE_MAX_UPLOAD_MB=25
FILE_PURGE_AFTER_DAYS=30       # bytes of deleted files are removed after N days (0 = never)
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=             # for MinIO / R2 / other S3-compatible services
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- email
EMAIL_PROVIDER=console         # console (dev: writes .eml previews, NOT delivered) | smtp
EMAIL_FROM="RightsFlow AI <no-reply@example.com>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# ---------------------------------------------------------------- AI (optional)
AI_PROVIDER=none               # none | anthropic | openai_compatible
# AI_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_BASE_URL=                 # required for openai_compatible (OpenAI: https://api.openai.com/v1)
# AI_TOKEN_LIMIT_PARAM=auto     # openai_compatible: auto | max_tokens | max_completion_tokens
# AI_EFFORT=medium
# AI_TIMEOUT_SECONDS=60
# AI_MAX_RETRIES=2
# AI_INPUT_COST_PER_MTOK=4.0   # used only for cost estimates
# AI_OUTPUT_COST_PER_MTOK=20.0

# ---------------------------------------------------------------- billing (optional)
BILLING_PROVIDER=manual        # manual (no charges) | stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------- background jobs
RUN_EMBEDDED_WORKER=true       # false when running `python -m app.worker` separately
WORKER_POLL_INTERVAL_SECONDS=2
JOB_STALE_AFTER_MINUTES=15

# ---------------------------------------------------------------- monitoring (optional)
# ERROR_MONITORING_DSN=        # Sentry-compatible DSN; also `pip install sentry-sdk`
