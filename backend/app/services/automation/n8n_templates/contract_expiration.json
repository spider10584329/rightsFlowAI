      "parameters": {
        "jsCode": "// Non-secret settings. The API key is in the organization's automation credential.\nconst triggeredBySchedule = $('On schedule').isExecuted;\nconst request = $('Run on request').isExecuted ? ($('Run on request').first().json.body || {}) : {};\nconst options = __RF_SETTINGS_JSON__;\nconst settings = {\n  apiBaseUrl: '__RF_API_URL__',\n  instanceId: '__RF_INSTANCE_ID__',\n  workflow: 'contract-expiration',\n  trigger: triggeredBySchedule ? 'schedule' : (request.trigger === 'event' ? 'event' : 'manual'),\n  executionId: String($execution.id),\n};\nsettings.thresholds = options.thresholds; // days before end date\nreturn [{ json: settings }];"
      }
