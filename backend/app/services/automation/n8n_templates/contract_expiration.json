    {
      "id": "7f08314b-fe51-574c-bdcf-4e6d6dc74e65",
      "name": "Plan reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "jsCode": "// Pick the tightest threshold each contract has reached (0 = already expired).\nconst thresholds = [...$('Config').first().json.thresholds].sort((a, b) => a - b);\nconst items = $('List expiring contracts').first().json.items || [];\nconst plan = [];\nfor (const c of items) {\n  const threshold = c.days_until_expiry < 0 ? 0 : thresholds.find((t) => c.days_until_expiry <= t);\n  if (threshold === undefined) continue;\n  plan.push({ hasWork: true, contract_id: c.contract_id, threshold_days: threshold,\n              days_until_expiry: c.days_until_expiry });\n}\nif (!plan.length) return [{ json: { hasWork: false, status: 'succeeded', summary: { contracts: 0 } } }];\nreturn plan.map((p) => ({ json: p }));"
      }
    },
