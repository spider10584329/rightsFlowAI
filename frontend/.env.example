# Server-only. URL of the FastAPI backend used by the BFF route handlers.
# Never expose it with a NEXT_PUBLIC_ prefix: the browser only talks to /api/*.
BACKEND_URL=http://127.0.0.1:8000

# Optional. Comma-separated public origins accepted by the CSRF/Origin check
# when a reverse proxy rewrites the Host header (e.g. https://app.example.com).
# APP_ORIGIN=

# Optional. Force the Secure cookie attribute on/off. Defaults to on when
# NODE_ENV=production.
# COOKIE_SECURE=true

# Number of reverse proxies in front of Next.js that append X-Forwarded-For
# (e.g. 1 behind nginx/a load balancer). 0 = trust none: client IPs are not
# forwarded to the API, which then rate-limits by the BFF address.
TRUSTED_PROXY_HOPS=0
