              "value": "45"
            }
          ]
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "RfAutomationKey1",
          "name": "RightsFlow automation key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "ebce76e3-8983-5681-8533-300bc723fd59",
      "name": "Review results",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2880,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.apiBaseUrl }}/api/v1/automation/statements/{{ $('Collect statements').item.json.statement_id }}/review",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Correlation-ID",
              "value": "=n8n-{{ $execution.id }}"
            },
            {
              "name": "X-Automation-Instance",
              "value": "={{ $('Config').first().json.instanceId }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $('Config').first().json.instanceId }}:review-{{ $execution.id }}-{{ $('Collect statements').item.json.statement_id }}"
