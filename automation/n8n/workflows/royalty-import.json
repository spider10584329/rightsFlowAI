      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "parameters": {}
    },
    {
      "id": "8de854cb-4c6f-569f-ad1b-aaf40d1e8dd5",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        400
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "24b86877-d41a-510f-b619-78047cb20ad5",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "jsCode": "// Non-secret settings. The API key is in the \"RightsFlow automation key\" credential.\nconst triggeredBySchedule = $('Every 15 minutes').isExecuted;\nconst settings = {\n  apiBaseUrl: '__RIGHTSFLOW_API_URL__',\n  instanceId: '__RIGHTSFLOW_INSTANCE_ID__',\n  workflow: 'royalty-import',\n  trigger: triggeredBySchedule ? 'schedule' : 'manual',\n  executionId: String($execution.id),\n};\n// Every file is offered to the API, which accepts CSV/TSV/TXT/XLSX and records an explicit\n// rejection for anything else (e.g. legacy .xls), instead of ignoring it.\nsettings.inboxGlob = '__RIGHTSFLOW_INBOX__/*.*';\nreturn [{ json: settings }];"
      }
    },
    {
      "id": "50740a4a-fb89-552b-816a-5f2bd195d4f6",
      "name": "Start run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.apiBaseUrl }}/api/v1/automation/runs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Correlation-ID",
              "value": "=n8n-{{ $execution.id }}"
            },
            {
              "name": "X-Automation-Instance",
              "value": "={{ $('Config').first().json.instanceId }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $('Config').first().json.instanceId }}:run-start-{{ $execution.id }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: $('Config').first().json.workflow, trigger_type: $('Config').first().json.trigger, execution_id: $('Config').first().json.executionId }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "RfAutomationKey1",
          "name": "RightsFlow automation key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "1b7eb1a0-405e-537e-88ab-b1fe1bf9e067",
      "name": "Read inbox files",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        720,
        300
      ],
      "parameters": {
        "operation": "read",
        "fileSelector": "={{ $('Config').first().json.inboxGlob }}",
        "options": {}
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "e9404f85-9eec-563e-bb82-5e8769965ec3",
      "name": "Any files?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "7a8b5063-9ead-5313-a3e3-9052c8ff9bf1",
              "leftValue": "={{ !!($binary && $binary.data) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "d7e46aea-e18d-574d-86d2-bccbd3612a72",
      "name": "Describe file",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "jsCode": "// Inbox naming convention: <source_category>__<source name>__<YYYY-MM>[__<CUR>].csv\n// e.g. distributor__Distro Inc__2026-09__USD.csv. Anything else is sent with an\n// invalid category so the API rejects it (422) and the run summary lists it.\nconst fileName = $input.item.binary.data.fileName || 'unknown.csv';\nconst stem = fileName.replace(/\\.[^.]+$/, '');\nconst parts = stem.split('__');\nconst [category, source, period, currency] = parts;\nlet periodStart = null, periodEnd = null;\nconst m = /^(\\d{4})-(\\d{2})$/.exec(period || '');\nif (m) {\n  const year = Number(m[1]), month = Number(m[2]);\n  const last = new Date(Date.UTC(year, month, 0)).getUTCDate();\n  periodStart = `${m[1]}-${m[2]}-01`;\n  periodEnd = `${m[1]}-${m[2]}-${String(last).padStart(2, '0')}`;\n}\nconst valid = parts.length >= 3 && !!periodStart;\nreturn {\n  json: {\n    file_name: fileName,\n    valid_name: valid,\n    source_category: valid ? category : 'invalid_file_name',\n    source_name: (source || stem).slice(0, 200),\n    period_start: periodStart || '1970-01-01',\n    period_end: periodEnd || '1970-01-31',\n    currency: (currency || 'USD').toUpperCase(),\n  },\n  binary: $input.item.binary,\n};",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "72757681-bf07-5252-9ac6-3f4184d400dd",
      "name": "Upload statement",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.apiBaseUrl }}/api/v1/automation/statements",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Correlation-ID",
              "value": "=n8n-{{ $execution.id }}"
            },
            {
              "name": "X-Automation-Instance",
              "value": "={{ $('Config').first().json.instanceId }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $('Config').first().json.instanceId }}:upload-{{ $execution.id }}-{{ $itemIndex }}"
            }
          ]
        },
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "contentType": "multipart-form-data",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            },
            {
              "name": "source_name",
              "value": "={{ $json.source_name }}"
            },
            {
              "name": "source_category",
              "value": "={{ $json.source_category }}"
            },
            {
              "name": "period_start",
              "value": "={{ $json.period_start }}"
            },
            {
              "name": "period_end",
              "value": "={{ $json.period_end }}"
            },
            {
              "name": "currency",
              "value": "={{ $json.currency }}"
            }
          ]
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "RfAutomationKey1",
          "name": "RightsFlow automation key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "b669f8cb-b19e-5465-b5a2-8590d871dca1",
      "name": "Claim statement events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.apiBaseUrl }}/api/v1/automation/events/claim",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Correlation-ID",
              "value": "=n8n-{{ $execution.id }}"
            },
            {
              "name": "X-Automation-Instance",
              "value": "={{ $('Config').first().json.instanceId }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event_types: ['statement.uploaded', 'statement.ready'], limit: 10, lease_seconds: 600 }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "RfAutomationKey1",
          "name": "RightsFlow automation key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "executeOnce": true
    },
    {
      "id": "3867f060-1c28-50d3-84d7-01934ebfcc22",
      "name": "Collect statements",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        300
      ],
      "parameters": {
        "jsCode": "// One item per statement to process: inbox uploads (new or already imported)\n// plus statements users uploaded in the app (outbox events, leased to this run).\nconst work = [];\nif ($('Upload statement').isExecuted) {\n  const described = $('Describe file').all();\n  $('Upload statement').all().forEach((item, i) => {\n    const r = item.json;\n    if ((r.statusCode === 200 || r.statusCode === 201) && r.body && r.body.id) {\n      work.push({ statement_id: r.body.id, origin: r.body.duplicate ? 'inbox_duplicate' : 'inbox',\n                  file_name: (described[i] || {}).json?.file_name });\n    }\n  });\n}\nconst claim = $('Claim statement events').first().json;\nfor (const event of claim.events || []) {\n  work.push({ statement_id: event.payload.statement_id, origin: 'event', event_id: event.id,\n              lease_token: claim.lease_token });\n}\nif (!work.length) {\n  return [{ json: { hasWork: false, status: 'succeeded', summary: { statements: 0 } } }];\n}\nreturn work.map((w) => ({ json: { hasWork: true, ...w } }));"
      }
    },
    {
      "id": "9c9a1032-b474-5da8-af5c-5770509b8cb3",
      "name": "Anything to process?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2160,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "76a6bce9-5114-50ec-97da-d0f04a0dea84",
              "leftValue": "={{ $json.hasWork }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "d923a0fa-ab2d-5505-8c4b-d7ccd11caaeb",
      "name": "Start processing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2400,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.apiBaseUrl }}/api/v1/automation/statements/{{ $json.statement_id }}/process",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Correlation-ID",
              "value": "=n8n-{{ $execution.id }}"
            },
            {
              "name": "X-Automation-Instance",
              "value": "={{ $('Config').first().json.instanceId }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $('Config').first().json.instanceId }}:process-{{ $execution.id }}-{{ $json.statement_id }}"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "RfAutomationKey1",
          "name": "RightsFlow automation key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "53b08a1c-dc03-54b5-bdd5-1ed1eb4af1a7",
      "name": "Wait for processing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2640,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.apiBaseUrl }}/api/v1/automation/statements/{{ $('Collect statements').item.json.statement_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Correlation-ID",
              "value": "=n8n-{{ $execution.id }}"
            },
            {
