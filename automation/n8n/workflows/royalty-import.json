              "value": "={{ $('Config').first().json.instanceId }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $('Config').first().json.instanceId }}:run-finish-{{ $execution.id }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: $json.status || 'succeeded', summary: $json.summary || {} }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "RfAutomationKey1",
          "name": "RightsFlow automation key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
