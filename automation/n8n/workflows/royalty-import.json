          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ calculate: true, run_id: $('Start run').first().json.id, event_id: $('Collect statements').item.json.event_id || null, lease_token: $('Collect statements').item.json.lease_token || null }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "RfAutomationKey1",
          "name": "RightsFlow automation key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "7579d764-12de-53d7-a493-4d65e21be59a",
      "name": "Summarize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3120,
        300
      ],
      "parameters": {
        "jsCode": "const started = $('Start processing').all();\nconst results = $input.all().map((item, i) => {\n  const source = $('Collect statements').all()[i]?.json || {};\n  const r = item.json;\n  const body = r.body || {};\n  const progress = started[i]?.json?.body?.automation || {};\n  return {\n    statement_id: source.statement_id, origin: source.origin, http_status: r.statusCode,\n    automation: progress.outcome || null, attempts: progress.attempts ?? null,\n    needs_review: body.needs_review === true, review_task: body.task_change || null,\n    error: r.statusCode >= 300 ? (body.error?.code || `http_${r.statusCode}`) : null,\n  };\n});\nconst rejected = [];\nif ($('Upload statement').isExecuted) {\n  const described = $('Describe file').all();\n  $('Upload statement').all().forEach((item, i) => {\n    if (![200, 201].includes(item.json.statusCode)) {\n      rejected.push({ file: (described[i] || {}).json?.file_name, http_status: item.json.statusCode,\n                      code: item.json.body?.error?.code || null,\n                      seen_before: (item.json.body?.inbox_file?.times_seen || 1) > 1 });\n    }\n  });\n}\nconst failed = results.filter((r) => r.error);\nreturn [{ json: {\n  status: failed.length || rejected.length ? 'partial' : 'succeeded',\n  summary: {\n    statements: results.length,\n    needing_review: results.filter((r) => r.needs_review).length,\n    from_inbox: results.filter((r) => r.origin !== 'event').length,\n    awaiting_mapping: results.filter((r) => (r.automation || '').startsWith('awaiting') || r.automation === 'mapping_required').length,\n    retry_waiting: results.filter((r) => ['retry_scheduled', 'retry_waiting'].includes(r.automation)).length,\n    needs_manual_review: results.filter((r) => r.automation === 'needs_manual_review').length,\n    from_events: results.filter((r) => r.origin === 'event').length,\n    failed: failed.length, rejected_files: rejected.length, rejected, results,\n  },\n} }];"
      }
    },
    {
      "id": "1ed45a98-1b69-57db-ada4-01820a61e0ad",
      "name": "Finish run",
      "type": "n8n-nodes-base.httpRequest",
