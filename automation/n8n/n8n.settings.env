# Non-secret n8n settings for the RightsFlow AI local automation environment.
# Loaded into the n8n *process* only by scripts\start-n8n.ps1 (never set globally).
# Secrets (N8N_ENCRYPTION_KEY) live in %LOCALAPPDATA%\RightsFlowAI\n8n\secrets\n8n.env.
# Paths, port and bind address are set by scripts\n8n-common.ps1.

N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
GENERIC_TIMEZONE=UTC
TZ=UTC

# Storage: n8n's own SQLite database in its user folder, separate from MariaDB.
DB_TYPE=sqlite

# Execution history and retention (14 days, at most 10,000 executions).
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000
EXECUTIONS_TIMEOUT=900
EXECUTIONS_TIMEOUT_MAX=3600

# Logging
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console,file
N8N_LOG_FILE_SIZE_MAX=16
N8N_LOG_FILE_COUNT_MAX=10

# Privacy / local-only
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false
# The editor is served over plain http on localhost only.
N8N_SECURE_COOKIE=false

# Workflows may not read the process environment (it holds the encryption key).
N8N_BLOCK_ENV_ACCESS_IN_NODE=true

# Workflows use JavaScript only: disable Python in Code nodes. n8n 2.43.5 still
# checks for the Python runner once per process start in internal mode and logs one
# "virtual environment is missing" warning; no setting suppresses it (audit N8N-14).
N8N_PYTHON_ENABLED=false
# Defaults n8n announced it will change; pinned so behaviour doesn't shift on upgrade.
N8N_RUNNERS_TASK_TIMEOUT=300
N8N_UNVERIFIED_PACKAGES_ENABLED=false
N8N_COMMUNITY_PACKAGES_ENABLED=false
